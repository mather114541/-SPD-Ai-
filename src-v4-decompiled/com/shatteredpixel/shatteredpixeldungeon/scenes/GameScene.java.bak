    public static void add(Mob mob, float delay) {
        Dungeon.level.mobs.add(mob);
        delay = (float)Math.ceil(Actor.now() + delay) - Actor.now();
        if (scene != null) {
            scene.addMobSprite(mob);
            Actor.addDelayed(mob, delay);
            mob.spendToWhole();
        }
    }

